# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > API). Never commit the real .env file.
#
# Only the public "anon" key belongs here. Never put the service_role key in a
# VITE_ variable: everything prefixed with VITE_ is bundled into the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional. The address used in student links and QR codes. Leave it unset to use
# the address the site is served from. Set it to test with a phone during
# development (use your computer's network address), then restart the dev server.
# VITE_PUBLIC_BASE_URL=http://192.168.1.20:5173

# Optional, only for `npm run check:security`: the instructor account you created in
# Supabase (Authentication > Users). Lets the script also check what the instructor
# can do. Real credentials belong only in your local .env, never in this file.
# TEST_INSTRUCTOR_EMAIL=instructor@example.com
# TEST_INSTRUCTOR_PASSWORD=your-instructor-password
